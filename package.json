{
  "name": "kintone-record-diff-viewer",
  "version": "0.1.0",
  "description": "Compare two records in the same kintone app side by side and highlight the differences, including inline diffs for rich text and row matching for subtables.",
  "author": "Koji Miyazawa",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"test/**/*.ts\"",
    "pack": "npm run build && node scripts/pack.mjs"
  },
  "dependencies": {
    "@kintone/rest-api-client": "^5.7.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cybozu/eslint-config": "^24.0.0",
    "@kintone/dts-gen": "^8.1.1",
    "@kintone/plugin-packer": "^8.1.1",
    "@playwright/test": "^1.45.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
